# Copy to .env.local and fill in. In production these are set on the Vercel web project.

# Base URL of the API, including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Cloudflare Turnstile site key. The value below is Cloudflare's test key (always passes);
# use the real site key in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: canonical site URL for metadata, sitemap and robots. Defaults to the Vercel
# production URL when unset.
# NEXT_PUBLIC_SITE_URL=https://eduexcellence.in

# Optional, dev only: proxy /api through the web server so one public tunnel reaches both apps.
# Use together with NEXT_PUBLIC_API_URL=/api
# DEV_API_PROXY=http://localhost:5000
