# Copy to .env and fill in. Never commit .env — it holds live credentials.
# In production these are set as environment variables on the Vercel API project.

PORT=5000

# MongoDB Atlas connection string (include the database name after the host if one is wanted).
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/

# Long random string used to sign admin login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
MAIL_FROM=EduExcellence <onboarding@resend.dev>
ADMIN_EMAIL=
SITE_URL=https://eduexcellence.in
EMAIL_LOGO_URL=https://eduexcellance-web-hapg.vercel.app/assets/logo-white.png
# Optional: while the Resend domain is unverified, redirect all outgoing mail to one inbox.
MAIL_OVERRIDE_TO=

# Cloudflare Turnstile server secret. The value below is Cloudflare's test secret (always passes);
# use the real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
